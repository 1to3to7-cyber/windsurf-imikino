# ===========================================
# IMIKINO ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and update with your values

# ===========================================
# APPLICATION SETTINGS
# ===========================================
NODE_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_HOST=localhost
API_PORT=8000
FRONTEND_HOST=localhost
FRONTEND_PORT=3000

# ===========================================
# SECURITY KEYS (IMPORTANT: Generate secure random values)
# ===========================================
# Generate with: openssl rand -base64 32
SECRET_KEY=your-super-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production
REFRESH_TOKEN_SECRET=your-refresh-token-secret-here-change-in-production

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# SQLite (Development)
DATABASE_URL=sqlite:///./imikino.db

# PostgreSQL (Production - uncomment and configure)
# DATABASE_URL=postgresql://username:password@localhost:5432/imikino_production

# ===========================================
# EMAIL CONFIGURATION
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@imikino.rw
ADMIN_EMAIL=1to3to7@gmail.com

# ===========================================
# CORS CONFIGURATION
# ===========================================
CORS_ORIGINS=http://localhost:3000,https://imikino.rw,https://www.imikino.rw
CORS_ALLOW_CREDENTIALS=true

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ===========================================
# FILE UPLOAD CONFIGURATION
# ===========================================
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx
UPLOAD_DIR=./uploads

# ===========================================
# REDIS CONFIGURATION (Optional - for caching)
# ===========================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ===========================================
# MONITORING CONFIGURATION
# ===========================================
SENTRY_DSN=
PROMETHEUS_ENABLED=false
GRAFANA_PASSWORD=admin123

# ===========================================
# FRONTEND ENVIRONMENT VARIABLES
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Imikino
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_DESCRIPTION=Social-learning + micro-task platform for Rwandan youth
NEXT_PUBLIC_SUPPORT_EMAIL=support@imikino.rw

# ===========================================
# SOCIAL MEDIA INTEGRATION
# ===========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# ===========================================
# PAYMENT CONFIGURATION (Future feature)
# ===========================================
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ===========================================
# ANALYTICS CONFIGURATION
# ===========================================
GOOGLE_ANALYTICS_ID=
HOTJAR_ID=
MIXPANEL_TOKEN=

# ===========================================
# DEVELOPMENT SPECIFIC
# ===========================================
# Enable hot reload and detailed logging in development
ENABLE_SWAGGER=true
ENABLE_DEBUG_ROUTES=true
MOCK_EMAIL_SERVICE=false

# ===========================================
# PRODUCTION SPECIFIC
# ===========================================
# Security headers and optimizations
ENABLE_HTTPS=true
ENABLE_COMPRESSION=true
ENABLE_CACHE=true
MINIFY_ASSETS=true

# ===========================================
# TESTING CONFIGURATION
# ===========================================
TEST_DATABASE_URL=sqlite:///./test_imikino.db
TEST_EMAIL_RECIPIENT=test@example.com
DISABLE_RATE_LIMITING_IN_TESTS=true
